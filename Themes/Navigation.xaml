<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Navigation styles. The sidebar row is a RadioButton whose checked state is bound to
        the view model, so the highlighted item and the displayed page can never drift apart.
    -->

    <!--
        Sidebar navigation row.
        The checked state is bound to the view model, so the highlighted item and the
        displayed page can never drift apart (the previous version mutated brushes from
        code-behind and had to keep two sources of truth in sync).
    -->
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Navigation" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Root"
                        Background="{StaticResource TransparentBrush}"
                        CornerRadius="{StaticResource SmallCornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Thin accent bar, only visible on the active item -->
                            <Border
                                x:Name="AccentBar"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                Background="{StaticResource TransparentBrush}"
                                CornerRadius="2" />

                            <ContentPresenter
                                Margin="18,0,10,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover: subtle surface lift -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>

                        <!-- Active page -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <!-- Entries that are not implemented yet -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
