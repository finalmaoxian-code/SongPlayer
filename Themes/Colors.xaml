<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Design tokens (single source of truth for the whole app).
        Every color, radius and spacing value used by the views is declared here so the
        look of the application can be re-skinned without touching any view markup.
    -->

    <!-- ============================ Palette ============================ -->

    <!-- Window / outermost surface -->
    <Color x:Key="WindowBackgroundColor">#0E1014</Color>
    <!-- Sidebar and player bar (slightly lifted above the window) -->
    <Color x:Key="Surface1Color">#151821</Color>
    <!-- Cards and content blocks -->
    <Color x:Key="Surface2Color">#1B1F29</Color>
    <!-- Hover state of an interactive row -->
    <Color x:Key="Surface3Color">#232833</Color>
    <!-- Inactive slider track and subtle separators -->
    <Color x:Key="Surface4Color">#2C323E</Color>
    <!-- Hairline borders -->
    <Color x:Key="BorderColor">#242936</Color>

    <!-- Brand accent -->
    <Color x:Key="AccentColor">#A78BFA</Color>
    <Color x:Key="AccentStrongColor">#8B5CF6</Color>
    <!-- Tinted accent used for the active navigation item -->
    <Color x:Key="AccentSoftColor">#2C2545</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F3F4F8</Color>
    <Color x:Key="TextSecondaryColor">#9BA2B2</Color>
    <Color x:Key="TextTertiaryColor">#6B7285</Color>

    <!-- Window caption buttons -->
    <Color x:Key="CaptionHoverColor">#222834</Color>
    <Color x:Key="CaptionCloseHoverColor">#E5484D</Color>

    <!-- ============================ Brushes ============================ -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Surface4Brush" Color="{StaticResource Surface4Color}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <!-- Dark text/glyph color used on top of a solid accent surface -->
    <SolidColorBrush x:Key="AccentOnSolidBrush" Color="#14111F" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="CaptionHoverBrush" Color="{StaticResource CaptionHoverColor}" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{StaticResource CaptionCloseHoverColor}" />

    <!-- Transparent brush used for the "idle" state of icon buttons -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- Soft radial glow placed behind the home hero banner -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3B2E63" />
        <GradientStop Offset="0.55" Color="#282043" />
        <GradientStop Offset="1" Color="#1B1F29" />
    </LinearGradientBrush>

    <!-- ============================ Metrics ============================ -->

    <!-- Corner radii -->
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">10</CornerRadius>

    <!-- Typography scale -->
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>

    <!-- Shared typeface: Segoe UI Variable ships with Windows 11, plain Segoe UI is the fallback -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
