<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Surface styles: the containers that give content its shape. Only Border targets, so
        this dictionary has no dependencies beyond the colour tokens.
    -->

    <!-- Standard content card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <!-- Muted inner surface used inside cards for thumbnails / icon wells -->
    <Style x:Key="WellStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}" />
    </Style>

    <!-- Metadata chip, e.g. "Track 04" or "FLAC" -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

</ResourceDictionary>
