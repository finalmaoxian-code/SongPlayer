<UserControl
    x:Class="SongPlayer.Views.Shell.CaptionBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    mc:Ignorable="d">
    <Grid
        Background="{StaticResource WindowBackgroundBrush}"
        Visibility="{Binding IsNowPlayingOpen, Converter={StaticResource InverseBoolToVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand -->
        <StackPanel Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock
                Text="&#xE8D6;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="13"
                Foreground="{StaticResource AccentBrush}"
                VerticalAlignment="Center" />
            <TextBlock
                Text="SongPlayer"
                Margin="9,0,0,0"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextSecondaryBrush}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- Window caption buttons, hit-testable inside the chrome area -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button
                Content="&#xE921;"
                Click="MinimizeButton_Click"
                Style="{StaticResource CaptionButtonStyle}"
                ToolTip="Minimize" />
            <Button
                x:Name="MaximizeButton"
                Content="&#xE922;"
                Click="MaximizeButton_Click"
                Style="{StaticResource CaptionButtonStyle}"
                ToolTip="Maximize" />
            <Button
                Content="&#xE8BB;"
                Click="CloseButton_Click"
                Style="{StaticResource CaptionCloseButtonStyle}"
                ToolTip="Close" />
        </StackPanel>
    </Grid>
</UserControl>
