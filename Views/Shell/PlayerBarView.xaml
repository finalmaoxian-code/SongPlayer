<UserControl
    x:Class="SongPlayer.Views.Shell.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:SongPlayer.Controls"
    mc:Ignorable="d">
    <Border
        Margin="12,12,12,12"
        Padding="14,0"
        Background="{StaticResource Surface1Brush}"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Now playing. The artwork is a button: clicking it opens the immersive view. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    AutomationProperties.Name="Open Now Playing"
                    Command="{Binding OpenNowPlayingCommand}"
                    Style="{StaticResource ArtworkButtonStyle}"
                    ToolTip="Open Now Playing">
                    <!--
                        Real artwork when the track has some, the procedural glyph otherwise.
                        Both live in the same 52x52 button so the bar keeps its rhythm.
                    -->
                    <Grid>
                        <!-- An ImageBrush instead of an Image so the corners follow the
                             button frame; an Image would paint over the rounded border. The
                             bitmap arrives already decoded, so a missing cover simply never
                             sets this branch. -->
                        <Border
                            Width="50"
                            Height="50"
                            CornerRadius="4"
                            Visibility="{Binding PlayerBar.HasCover, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PlayerBar.CoverImage}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock
                            Text="{Binding PlayerBar.ArtworkGlyph}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="19"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PlayerBar.HasNoCover, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding PlayerBar.TrackTitle}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />

                    <!--
                        The second line doubles as the transport error line: a failed play has
                        nowhere else to go in this shell, and the player bar is where the user
                        just clicked.

                        For local files it shows the artist tag. For online videos the same slot
                        carries the uploader, prefixed so nobody reads it as the artist.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{Binding PlayerBar.SourceLabel}"
                            Style="{StaticResource CaptionTextStyle}"
                            Foreground="{StaticResource AccentBrush}"
                            Visibility="{Binding PlayerBar.HasSourceLabel, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="6,4,6,0"
                            Text="·"
                            Style="{StaticResource CaptionTextStyle}"
                            Visibility="{Binding PlayerBar.HasSourceLabel, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{Binding PlayerBar.TrackArtist}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding PlayerBar.HasStatusMessage, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="{Binding PlayerBar.StatusMessage}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource CaptionCloseHoverBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding PlayerBar.StatusMessage}"
                        Visibility="{Binding PlayerBar.HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Button
                    Margin="14,0,0,0"
                    Content="&#xEB51;"
                    IsEnabled="{Binding PlayerBar.HasTrack}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Add to favorites" />
            </StackPanel>

            <!-- Transport controls + seek bar -->
            <StackPanel
                Grid.Column="1"
                MinWidth="380"
                Margin="24,0"
                VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Content="&#xE8B1;"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Shuffle (coming soon)" />

                    <Button
                        Margin="6,0,0,0"
                        Command="{Binding PlayerBar.RestartCommand}"
                        Content="&#xE892;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Restart track" />

                    <Button
                        Margin="8,0"
                        Command="{Binding PlayerBar.TogglePlaybackCommand}"
                        Content="{Binding PlayerBar.PlayPauseGlyph}"
                        Style="{StaticResource PlayButtonStyle}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{Binding PlayerBar.PlayPauseTooltip}" />

                    <Button
                        Margin="0,0,6,0"
                        Content="&#xE893;"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Next (needs a queue)" />

                    <Button
                        Content="&#xE8EE;"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Repeat (coming soon)" />
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{Binding PlayerBar.PositionText}"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center" />

                    <controls:SlimSlider
                        x:Name="SeekBar"
                        Grid.Column="1"
                        Margin="4,0"
                        Maximum="{Binding PlayerBar.DurationSeconds}"
                        Value="{Binding PlayerBar.PositionSeconds, Mode=TwoWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding PlayerBar.DurationText}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Volume -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <Button
                    Command="{Binding PlayerBar.ToggleMuteCommand}"
                    Content="{Binding PlayerBar.VolumeGlyph}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding PlayerBar.MuteTooltip}" />
                <controls:SlimSlider
                    Width="110"
                    Margin="6,0,0,0"
                    Maximum="100"
                    Value="{Binding PlayerBar.Volume, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip="Volume" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
