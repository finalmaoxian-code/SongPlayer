<UserControl
    x:Class="SongPlayer.Views.Shell.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:SongPlayer.Controls"
    mc:Ignorable="d">
    <Border
        Margin="12,12,12,12"
        Padding="14,0"
        Background="{StaticResource Surface1Brush}"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Now playing. The artwork is a button: clicking it opens the immersive view. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    AutomationProperties.Name="Open Now Playing"
                    Command="{Binding OpenNowPlayingCommand}"
                    Style="{StaticResource ArtworkButtonStyle}"
                    ToolTip="Open Now Playing">
                    <TextBlock
                        Text="&#xE8D6;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="19"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Button>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding TrackTitle}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="{Binding TrackArtist}"
                        Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <Button
                    Margin="14,0,0,0"
                    Content="&#xEB51;"
                    IsEnabled="{Binding HasTrack}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Add to favorites" />
            </StackPanel>

            <!-- Transport controls + seek bar -->
            <StackPanel
                Grid.Column="1"
                MinWidth="380"
                Margin="24,0"
                VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Content="&#xE8B1;"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Shuffle (coming soon)" />

                    <Button
                        Margin="6,0,0,0"
                        Content="&#xE892;"
                        IsEnabled="{Binding HasTrack}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Previous" />

                    <Button
                        Margin="8,0"
                        Command="{Binding TogglePlaybackCommand}"
                        Content="{Binding PlayPauseGlyph}"
                        Style="{StaticResource PlayButtonStyle}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{Binding PlayPauseTooltip}" />

                    <Button
                        Margin="0,0,6,0"
                        Content="&#xE893;"
                        IsEnabled="{Binding HasTrack}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Next" />

                    <Button
                        Content="&#xE8EE;"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Repeat (coming soon)" />
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{Binding PositionText}"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center" />

                    <controls:SlimSlider
                        Grid.Column="1"
                        Margin="4,0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding DurationText}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Volume -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <Button
                    Content="&#xE767;"
                    IsEnabled="False"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Mute" />
                <controls:SlimSlider
                    Width="110"
                    Margin="6,0,0,0"
                    Maximum="100"
                    Value="{Binding Volume, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip="Volume" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
