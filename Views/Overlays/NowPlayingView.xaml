<UserControl
    x:Class="SongPlayer.Views.Overlays.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:SongPlayer.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    mc:Ignorable="d">
    <Grid
        Background="{StaticResource WindowBackgroundBrush}"
        Visibility="{Binding IsNowPlayingOpen, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Overlay caption: back on the left, window controls on the right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Margin="12,0,0,0"
                AutomationProperties.Name="Close Now Playing"
                Command="{Binding CloseNowPlayingCommand}"
                Content="&#xE70D;"
                Style="{StaticResource IconButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Back to the previous page (Esc)" />

            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                Text="NOW PLAYING"
                Style="{StaticResource SectionLabelStyle}"
                VerticalAlignment="Center" />

            <!-- Same handlers as the main caption so the window stays controllable -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    Content="&#xE921;"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize" />
                <Button
                    x:Name="OverlayMaximizeButton"
                    Content="&#xE922;"
                    Click="MaximizeButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Maximize" />
                <Button
                    Content="&#xE8BB;"
                    Click="CloseButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- Artwork + transport on the left, lyrics on the right -->
        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" MaxWidth="480" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ===================================================== -->
            <!-- Artwork, track facts and transport                    -->
            <!-- ===================================================== -->
            <Border
                Grid.Column="0"
                Padding="24,24,24,20"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Artwork takes the slack so it stays vertically centred -->
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Cover art. A Viewbox keeps the placeholder square at every window
                        size; once real cover images are loaded only the child of the
                        Viewbox has to change.
                    -->
                    <Viewbox
                        Grid.Row="0"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <Border
                            Width="340"
                            Height="340"
                            Background="{StaticResource HeroGradientBrush}"
                            Style="{StaticResource ArtworkFrameStyle}">
                            <Grid>
                                <!-- Concentric rings lend the flat gradient some depth -->
                                <Ellipse
                                    Width="248"
                                    Height="248"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="#26FFFFFF"
                                    StrokeThickness="1" />
                                <Ellipse
                                    Width="164"
                                    Height="164"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="#1AFFFFFF"
                                    StrokeThickness="1" />
                                <!--
                                    Real artwork covers the procedural rings when the track
                                    carries a thumbnail; the rings and glyph stay behind it as
                                    the fallback so the frame is never empty.
                                -->
                                <Border
                                    CornerRadius="16"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Visibility="{Binding PlayerBar.HasCover, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PlayerBar.CoverImage}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <TextBlock
                                    Text="{Binding PlayerBar.ArtworkGlyph}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="68"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PlayerBar.HasNoCover, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Viewbox>

                    <!-- Track facts -->
                    <StackPanel Grid.Row="1">
                        <TextBlock
                            Text="{Binding PlayerBar.TrackTitle}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Margin="0,6,0,0"
                            Text="{Binding PlayerBar.TrackArtist}"
                            FontSize="14"
                            Foreground="{StaticResource AccentBrush}"
                            TextTrimming="CharacterEllipsis" />

                        <!--
                            Online tracks get a source chip instead of the album chips: the
                            uploader is not an artist and a video has no album, so printing
                            "No album" would report a missing field as missing metadata.
                        -->
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Border
                                Style="{StaticResource ChipStyle}"
                                Visibility="{Binding PlayerBar.HasAlbumTags, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Text="{Binding PlayerBar.TrackAlbumPosition}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border
                                Margin="8,0,0,0"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{Binding PlayerBar.HasAlbumTags, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Text="{Binding PlayerBar.TrackAlbum}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border
                                Style="{StaticResource ChipStyle}"
                                Visibility="{Binding PlayerBar.HasSourceLabel, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Text="{Binding PlayerBar.SourceLabel}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Seek bar: same bindings as the player bar, so both stay in sync -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding PlayerBar.PositionText}"
                            Style="{StaticResource CaptionTextStyle}"
                            VerticalAlignment="Center" />

                        <controls:SlimSlider
                            Grid.Column="1"
                            Margin="4,0"
                            Maximum="{Binding PlayerBar.DurationSeconds}"
                            Value="{Binding PlayerBar.PositionSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding PlayerBar.DurationText}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextStyle}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- Transport controls -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Content="&#xE8B1;"
                            IsEnabled="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Shuffle (coming soon)" />
                        <Button
                            Margin="8,0,0,0"
                            Content="&#xE892;"
                            IsEnabled="{Binding PlayerBar.HasTrack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Previous" />
                        <Button
                            Margin="10,0"
                            Command="{Binding PlayerBar.TogglePlaybackCommand}"
                            Content="{Binding PlayerBar.PlayPauseGlyph}"
                            Style="{StaticResource PlayButtonStyle}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding PlayerBar.PlayPauseTooltip}" />
                        <Button
                            Margin="0,0,8,0"
                            Content="&#xE893;"
                            IsEnabled="{Binding PlayerBar.HasTrack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Next" />
                        <Button
                            Content="&#xE8EE;"
                            IsEnabled="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Repeat (coming soon)" />
                    </StackPanel>

                    <!-- Volume: the player bar is covered by the overlay, so it lives here -->
                    <StackPanel
                        Grid.Row="4"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Text="&#xE767;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            VerticalAlignment="Center" />
                        <controls:SlimSlider
                            Width="120"
                            Margin="10,0,0,0"
                            Maximum="100"
                            Value="{Binding PlayerBar.Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip="Volume" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- Visualizer / lines                                    -->
            <!-- ===================================================== -->
            <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="16,16,10,16"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Two chips instead of a single toggle: a segmented control shows both
                            options and which one is active, where a toggle would only label the
                            state the user is not in. The selection lives in the view model, so
                            each chip only mirrors it into IsChecked (OneWay).
                        -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                GroupName="OverlayCard"
                                Content="Visualizer"
                                IsChecked="{Binding NowPlaying.IsVisualizerSelected, Mode=OneWay}"
                                Command="{Binding NowPlaying.ShowVisualizerCommand}"
                                Style="{StaticResource OverlayTabStyle}" />
                            <RadioButton
                                GroupName="OverlayCard"
                                Margin="8,0,0,0"
                                Content="{Binding NowPlaying.SectionLabel}"
                                IsChecked="{Binding NowPlaying.IsLyricsSelected, Mode=OneWay}"
                                Command="{Binding NowPlaying.ShowLyricsCommand}"
                                Style="{StaticResource OverlayTabStyle}"
                                ToolTip="Lyrics for this track, looked up automatically" />
                        </StackPanel>

                        <!--
                            Offset nudges. A fixed offset can only correct a constant lead or lag,
                            which is the one timing error a listener can actually perceive and fix by
                            ear; a different arrangement or a speed change needs other lyrics instead.
                            The value is printed next to the buttons so the current correction is
                            never guessed at.
                        -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Visibility="{Binding NowPlaying.IsLyricsSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Text="{Binding NowPlaying.LyricOffsetText}"
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                ToolTip="Playback time minus this value is the lyric time." />
                            <Button
                                Content="-0.5 s"
                                Command="{Binding NowPlaying.OffsetEarlierCommand}"
                                Style="{StaticResource InlineChipButtonStyle}"
                                ToolTip="Show the lyrics this much earlier" />
                            <Button
                                Content="+0.5 s"
                                Margin="4,0,0,0"
                                Command="{Binding NowPlaying.OffsetLaterCommand}"
                                Style="{StaticResource InlineChipButtonStyle}"
                                ToolTip="Show the lyrics this much later" />
                            <Button
                                Content="Reset"
                                Margin="4,0,0,0"
                                Command="{Binding NowPlaying.ResetOffsetCommand}"
                                Style="{StaticResource InlineChipButtonStyle}"
                                Visibility="{Binding NowPlaying.HasLyricOffset, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Drop the offset back to zero" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <!--
                                Why this record was chosen, or what the lookup is doing.
                                The header is shared by both cards on purpose: a lookup that is
                                still running (or that failed) has to be visible from the
                                spectrum too, otherwise the lyric chip looks broken.
                            -->
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                MaxWidth="280"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding NowPlaying.MatchExplanation}"
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Visibility="{Binding NowPlaying.HasMatchExplanation, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{Binding NowPlaying.MatchExplanation}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding NowPlaying.QueryStatus}"
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Visibility="{Binding NowPlaying.HasQueryStatus, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Click a line to jump"
                                Style="{StaticResource CaptionTextStyle}"
                                Visibility="{Binding NowPlaying.ShowsLyricList, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!-- The live spectrum: what the track is doing right now -->
                    <Grid
                        Grid.Row="1"
                        Visibility="{Binding NowPlaying.IsVisualizerSelected, Converter={StaticResource BoolToVisibility}}">
                        <controls:AudioVisualizer
                            Margin="6,0,6,0"
                            AccentBrush="{StaticResource AccentBrush}"
                            IdleBrush="{StaticResource Surface4Brush}"
                            IsPlaying="{Binding PlayerBar.IsPlaying}" />
                        <TextBlock
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Text="{Binding PlayerBar.TrackAlbumPosition}"
                            Style="{StaticResource CaptionTextStyle}"
                            Foreground="{StaticResource TextTertiaryBrush}" />
                    </Grid>

                    <!--
                        Three faces of the lyric card, all in the same cell: the timed list, the
                        plain-text block for records without timing, and the candidate picker for a
                        lookup the matcher would not decide on its own. The state panel below covers
                        everything else, including loading and failure.
                    -->
                    <Grid
                        Grid.Row="1"
                        Visibility="{Binding NowPlaying.IsLyricsSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox
                            x:Name="LyricList"
                            Grid.Row="0"
                            ItemsSource="{Binding NowPlaying.Lyrics}"
                            Style="{StaticResource LyricListStyle}"
                            Visibility="{Binding NowPlaying.ShowsLyricList, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- The item template only renders text; padding and
                                         highlighting come from the container style. -->
                                    <TextBlock
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <!-- Derived from the shared style so the karaoke highlight
                                     stays in one place, plus the click-to-seek hook. -->
                                <Style BasedOn="{StaticResource LyricLineStyle}" TargetType="ListBoxItem">
                                    <EventSetter Event="MouseLeftButtonUp" Handler="LyricLine_MouseLeftButtonUp" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!--
                            Untimed lyrics: the words are readable, but nothing is highlighted and
                            nothing is clickable, because inventing timestamps would be a lie about
                            when the singer sings.
                        -->
                        <ScrollViewer
                            Grid.Row="0"
                            Margin="6,0,6,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding NowPlaying.ShowsPlainLyrics, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{Binding NowPlaying.PlainText}"
                                TextWrapping="Wrap"
                                LineHeight="24"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="14" />
                        </ScrollViewer>

                        <!--
                            The matcher could not decide, so the user decides. Each row carries
                            enough detail to tell a live take from the studio cut, and the score is
                            shown so the ordering is explainable instead of magic.
                        -->
                        <ListBox
                            Grid.Row="0"
                            Margin="6,0,6,0"
                            ItemsSource="{Binding NowPlaying.Candidates}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding NowPlaying.ShowsCandidateList, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,3"
                                        Padding="12,9"
                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                        Background="{StaticResource Surface2Brush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock
                                                    Text="{Binding Title}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Text="{Binding Artist}"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    Text="{Binding Detail}"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    FontSize="11"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="Use"
                                                Height="28"
                                                Padding="14,0"
                                                FontSize="12"
                                                Command="{Binding SelectCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Use these lyrics for this track from now on" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    <!--
                        Provenance footer. The wording follows the source that actually answered, so
                        a Bilibili video with real LRCLIB lyrics is never labelled as video subtitles.
                    -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="6,8,6,0"
                        Text="{Binding NowPlaying.SourceNotice}"
                        Style="{StaticResource CaptionTextStyle}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding NowPlaying.HasSourceNotice, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!--
                        Shown whenever the lyric card has nothing readable: loading, not found,
                        instrumental, network failure or a plain-text record with no timing. It has to
                        be hidden on the visualiser card as well, otherwise the panel floats over the
                        spectrum.
                    -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding NowPlaying.ShowsEmptyLyricState, Converter={StaticResource BoolToVisibility}}">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Style="{StaticResource WellStyle}">
                            <TextBlock
                                Text="&#xE8BD;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="22"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Text="{Binding NowPlaying.EmptyTitle}"
                            FontSize="15"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Margin="0,6,0,0"
                            MaxWidth="320"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Text="{Binding NowPlaying.EmptyHint}"
                            Style="{StaticResource BodyTextStyle}" />

                        <!--
                            Asking again is the only action a failure state needs, and it is also
                            what the user needs after correcting a wrong automatic match. It never
                            touches playback.
                        -->
                        <Button
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Content="Search again"
                            Command="{Binding NowPlaying.RetryCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding NowPlaying.CanRetry, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Ignore the cache and ask the lyric database again" />
                    </StackPanel>

                    <!--
                        Correction control for a match that turned out wrong. It is offered next to
                        the lyrics instead of hiding in a menu, because the moment the mistake is
                        noticed is the moment the fix should be one click away.
                    -->
                    <Button
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,8"
                        Content="Change lyrics"
                        Height="28"
                        Padding="12,0"
                        FontSize="12"
                        Command="{Binding NowPlaying.RetryCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding NowPlaying.CanChangeLyrics, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Look the track up again and forget the earlier choice" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
