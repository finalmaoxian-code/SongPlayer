<UserControl
    x:Class="SongPlayer.Views.Pages.LibraryPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Visibility="{Binding IsLibrarySelected, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding Library.LibrarySummary}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="{StaticResource FontSizeCaption}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Text="{Binding Library.StatusMessage}"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    FontSize="{StaticResource FontSizeCaption}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <Button
                    Margin="0,0,8,0"
                    Content="Clear library"
                    Command="{Binding Library.ClearLibraryCommand}"
                    Visibility="{Binding Library.HasTracks, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Content="Import folder"
                    Command="{Binding Library.ImportFolderCommand}"
                    IsEnabled="{Binding Library.IsBusy, Converter={StaticResource InverseBoolToBoolean}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Pick a folder and index every supported audio file in it" />
            </StackPanel>
        </Grid>

        <!--
            Bilibili input. It sits in the toolbar rather than in the empty state because the
            empty state disappears after the first import, and online playback has to stay
            reachable once a local library exists.
        -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding Bilibili.StatusMessage}"
                TextTrimming="CharacterEllipsis"
                FontSize="{StaticResource FontSizeCaption}">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource CaptionTextStyle}" TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Bilibili.HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource CaptionCloseHoverBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <TextBox
                    Width="200"
                    VerticalContentAlignment="Center"
                    IsEnabled="{Binding Bilibili.IsBusy, Converter={StaticResource InverseBoolToBoolean}}"
                    Style="{StaticResource SearchBoxStyle}"
                    Text="{Binding Bilibili.Bvid, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Bilibili video id, e.g. BV1GJ411x7h7">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding Bilibili.PlayCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button
                    Margin="8,0,0,0"
                    Content="Play BV…"
                    Command="{Binding Bilibili.PlayCommand}"
                    IsEnabled="{Binding Bilibili.IsBusy, Converter={StaticResource InverseBoolToBoolean}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Resolve the audio stream through the local bridge and play it" />
            </StackPanel>
        </Grid>

        <!-- Track table -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,4"
            Visibility="{Binding Library.HasTracks, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Grid Margin="16,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="#" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="TITLE"
                        Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="ALBUM"
                        Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock
                        Grid.Column="3"
                        MinWidth="54"
                        Text="TIME"
                        TextAlignment="Right"
                        Style="{StaticResource ColumnHeaderStyle}" />
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" />

                <ListBox
                    x:Name="TrackList"
                    Grid.Row="1"
                    ItemsSource="{Binding Library.Tracks}"
                    SelectionChanged="TrackList_SelectionChanged"
                    Style="{StaticResource TrackListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="&#xE8D6;" Style="{StaticResource TrackIndexGlyphStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Title}"
                                    Style="{StaticResource TrackTitleCellStyle}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding AlbumText}"
                                    Style="{StaticResource TrackAlbumCellStyle}"
                                    ToolTip="{Binding AlbumText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    MinWidth="54"
                                    Text="{Binding DurationText}"
                                    Style="{StaticResource TrackDurationCellStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <!--
                        Row selection is what loads a track (see the code-behind): it fires for
                        mouse clicks as well as for keyboard navigation, so the list needs no
                        separate click handler.
                    -->
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource TrackRowStyle}" TargetType="ListBoxItem" />
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Empty library state -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,4"
            Visibility="{Binding Library.HasNoTracks, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Style="{StaticResource WellStyle}">
                    <TextBlock
                        Text="&#xE8F1;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="28"
                        Foreground="{StaticResource AccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="No local music yet" />

                <TextBlock
                    Margin="0,8,0,20"
                    MaxWidth="400"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Text="Point SongPlayer at a folder and it will index your audio files. Nothing is copied or moved — the library only remembers where your files live."
                    Style="{StaticResource BodyTextStyle}" />

                <Button
                    Content="Import folder"
                    Command="{Binding Library.ImportFolderCommand}"
                    IsEnabled="{Binding Library.IsBusy, Converter={StaticResource InverseBoolToBoolean}}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
