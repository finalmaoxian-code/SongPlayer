<Window
    x:Class="SongPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:shellViews="clr-namespace:SongPlayer.Views.Shell"
    xmlns:pages="clr-namespace:SongPlayer.Views.Pages"
    xmlns:overlays="clr-namespace:SongPlayer.Views.Overlays"
    xmlns:vm="clr-namespace:SongPlayer.ViewModels"
    Title="SongPlayer"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    Background="{StaticResource WindowBackgroundBrush}"
    Foreground="{StaticResource TextPrimaryBrush}"
    FontFamily="{StaticResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <!--
        The window draws its own caption (WindowStyle=None) and uses WindowChrome to keep
        native resize borders, snap layouts and Aero snap working. CaptionHeight=40 tells
        Windows which strip of the window acts as the title bar, so dragging and
        double-click-to-maximize keep working for free.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--
        The shell view model is provided by the composition root in App.xaml.cs, so the window
        keeps a single DataContext and every composed view inherits it. The design-time instance
        below is what the XAML designer previews; it is stripped at runtime.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom caption -->
            <RowDefinition Height="40" />
            <!-- Navigation + page content -->
            <RowDefinition Height="*" />
            <!-- Player bar -->
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <!-- Caption bar: brand and the window buttons -->
        <shellViews:CaptionBarView Grid.Row="0" />

        <!-- Body: sidebar on the left, page header + active page on the right -->
        <Grid
            Grid.Row="1"
            Margin="12,0,12,0"
            Visibility="{Binding IsNowPlayingOpen, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <shellViews:SidebarView Grid.Column="0" />

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <shellViews:PageHeaderView Grid.Row="0" />

                <!-- Both pages share the content row; the visible one is selected in the view model. -->
                <pages:HomePageView Grid.Row="1" />
                <pages:LibraryPageView Grid.Row="1" />
            </Grid>
        </Grid>

        <shellViews:PlayerBarView Grid.Row="2" />

        <!--
            The immersive view spans all three rows, so opening it replaces the whole shell
            instead of merely covering it. Closing it restores the shell on whatever page the
            user came from.
        -->
        <overlays:NowPlayingView Grid.RowSpan="3" />
    </Grid>
</Window>
