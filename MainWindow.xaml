<Window
    x:Class="SongPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:controls="clr-namespace:SongPlayer.Controls"
    xmlns:vm="clr-namespace:SongPlayer.ViewModels"
    Title="SongPlayer"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    Background="{StaticResource WindowBackgroundBrush}"
    Foreground="{StaticResource TextPrimaryBrush}"
    FontFamily="{StaticResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    mc:Ignorable="d">

    <!--
        The window draws its own caption (WindowStyle=None) and uses WindowChrome to keep
        native resize borders, snap layouts and Aero snap working. CaptionHeight=40 tells
        Windows which strip of the window acts as the title bar, so dragging and
        double-click-to-maximize keep working for free.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--
        The shell view model is instantiated here so the window keeps a single DataContext and
        the child views inherit it. Its dependencies default to the sample implementations;
        the composition root will construct it explicitly once services are wired up.
    -->
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom caption -->
            <RowDefinition Height="40" />
            <!-- Navigation + page content -->
            <RowDefinition Height="*" />
            <!-- Player bar -->
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <!-- ===================================================================== -->
        <!-- Caption bar                                                           -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="0"
              Background="{StaticResource WindowBackgroundBrush}"
              Visibility="{Binding IsNowPlayingOpen, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand -->
            <StackPanel Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    Text="&#xE8D6;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="13"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="SongPlayer"
                    Margin="9,0,0,0"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Window caption buttons, hit-testable inside the chrome area -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    Content="&#xE921;"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize" />
                <Button
                    x:Name="MaximizeButton"
                    Content="&#xE922;"
                    Click="MaximizeButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Maximize" />
                <Button
                    Content="&#xE8BB;"
                    Click="CloseButton_Click"
                    Style="{StaticResource CaptionCloseButtonStyle}"
                    ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- ===================================================================== -->
        <!-- Body: sidebar + page host                                             -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="1"
              Margin="12,0,12,0"
              Visibility="{Binding IsNowPlayingOpen, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- Sidebar navigation                                            -->
            <!-- ============================================================= -->
            <Border
                Grid.Column="0"
                Padding="12,16,12,12"
                Background="{StaticResource Surface1Brush}"
                CornerRadius="{StaticResource CardCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Primary sections: IsChecked is bound to the view model, so the
                         highlight and the visible page are always the same thing. -->
                    <StackPanel>
                        <TextBlock Text="BROWSE" Style="{StaticResource SectionLabelStyle}" />

                        <!--
                            The checked state is bound two-way to the page selection itself, so
                            activating the item by any means (mouse, keyboard, UI Automation)
                            always navigates and the highlight can never drift from the content.
                        -->
                        <RadioButton
                            AutomationProperties.Name="Home"
                            IsChecked="{Binding IsHomeSelected, Mode=TwoWay}"
                            Style="{StaticResource NavItemStyle}">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource GlyphTextStyle}" FontSize="15" Margin="0,0,14,0" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <RadioButton
                            AutomationProperties.Name="Local Music"
                            IsChecked="{Binding IsLibrarySelected, Mode=TwoWay}"
                            Style="{StaticResource NavItemStyle}">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource GlyphTextStyle}" FontSize="15" Margin="0,0,14,0" />
                                    <TextBlock Text="Local Music" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <RadioButton
                            AutomationProperties.Name="Playlists"
                            IsEnabled="False"
                            Style="{StaticResource NavItemStyle}"
                            ToolTip="Playlists arrive in a later milestone">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource GlyphTextStyle}" FontSize="15" Margin="0,0,14,0" />
                                    <TextBlock Text="Playlists" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer note -->
                    <StackPanel Grid.Row="2">
                        <Border Height="1" Margin="0,0,0,12" Background="{StaticResource DividerBrush}" />
                        <StackPanel Margin="6,0,0,2" Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,8,0"
                                Fill="{StaticResource AccentBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="Preview build"
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- Page host                                                     -->
            <!-- ============================================================= -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shared page header: title, subtitle and the search field -->
                <Grid Margin="4,6,4,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource DisplayTextStyle}" />
                        <TextBlock
                            Text="{Binding PageSubtitle}"
                            Margin="0,6,0,0"
                            Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource SearchBoxStyle}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- ========================================================= -->
                <!-- HOME PAGE                                                 -->
                <!-- ========================================================= -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,6,0"
                    Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>

                        <!-- Hero banner -->
                        <Border
                            Padding="28,24"
                            Background="{StaticResource HeroGradientBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Your music, beautifully organized"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,9,0,0"
                                        MaxWidth="440"
                                        HorizontalAlignment="Left"
                                        Text="SongPlayer keeps your local collection in one calm, focused place. Import a folder and everything else falls into line."
                                        Style="{StaticResource BodyTextStyle}" />

                                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                        <Button
                                            Content="Browse local music"
                                            Command="{Binding ShowLibraryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button
                                            Margin="10,0,0,0"
                                            Content="Import folder"
                                            IsEnabled="False"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Folder import is coming in the next milestone" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Decorative album-art placeholder -->
                                <Border
                                    Grid.Column="1"
                                    Width="132"
                                    Height="132"
                                    Margin="28,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#40FFFFFF"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                    <TextBlock
                                        Text="&#xE8D6;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="46"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Quick access cards -->
                        <TextBlock
                            Margin="2,26,0,10"
                            Text="QUICK ACCESS"
                            Style="{StaticResource SectionLabelStyle}" />

                        <UniformGrid Columns="3">
                            <!-- Local music -->
                            <Border Margin="0,0,10,0" Padding="18" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource WellStyle}">
                                        <TextBlock
                                            Text="&#xE8F1;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="17"
                                            Foreground="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,0" Text="Local Music" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="0 tracks imported"
                                        Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Recently played -->
                            <Border Margin="5,0" Padding="18" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource WellStyle}">
                                        <TextBlock
                                            Text="&#xE81C;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="17"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,0" Text="Recently Played" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="Nothing yet"
                                        Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Favorites -->
                            <Border Margin="10,0,0,0" Padding="18" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource WellStyle}">
                                        <TextBlock
                                            Text="&#xEB51;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="17"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,0" Text="Favorites" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="Nothing yet"
                                        Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Empty state -->
                        <Border Margin="0,16,0,4" Padding="24,20" Style="{StaticResource CardStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WellStyle}">
                                    <TextBlock
                                        Text="&#xE8D6;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Your library is empty" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Text="Songs you import will appear here. Library scanning lands in the next milestone."
                                        Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================= -->
                <!-- LOCAL MUSIC PAGE                                          -->
                <!-- ========================================================= -->
                <Grid
                    Grid.Row="1"
                    Visibility="{Binding IsLibrarySelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="0 tracks · 0 albums"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="{StaticResource FontSizeCaption}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="1"
                            Content="Import folder"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Folder import is coming in the next milestone" />
                    </Grid>

                    <!-- Empty library state -->
                    <Border Grid.Row="1" Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border
                                Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                Style="{StaticResource WellStyle}">
                                <TextBlock
                                    Text="&#xE8F1;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <TextBlock
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="No local music yet" />

                            <TextBlock
                                Margin="0,8,0,20"
                                MaxWidth="400"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Text="Point SongPlayer at a folder and it will index your audio files. The import pipeline is the next milestone."
                                Style="{StaticResource BodyTextStyle}" />

                            <Button
                                Content="Import folder"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Folder import is coming in the next milestone" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================================================================== -->
        <!-- Player bar                                                            -->
        <!-- ===================================================================== -->
        <Border
            Grid.Row="2"
            Margin="12,12,12,12"
            Padding="14,0"
            Background="{StaticResource Surface1Brush}"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Now playing. The artwork is a button: clicking it opens the immersive view. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        AutomationProperties.Name="Open Now Playing"
                        Command="{Binding OpenNowPlayingCommand}"
                        Style="{StaticResource ArtworkButtonStyle}"
                        ToolTip="Open Now Playing">
                        <TextBlock
                            Text="&#xE8D6;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="19"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Button>

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding TrackTitle}"
                            FontSize="{StaticResource FontSizeBody}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{Binding TrackArtist}"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Button
                        Margin="14,0,0,0"
                        Content="&#xEB51;"
                        IsEnabled="{Binding HasTrack}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Add to favorites" />
                </StackPanel>

                <!-- Transport controls + seek bar -->
                <StackPanel
                    Grid.Column="1"
                    MinWidth="380"
                    Margin="24,0"
                    VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Content="&#xE8B1;"
                            IsEnabled="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Shuffle (coming soon)" />

                        <Button
                            Margin="6,0,0,0"
                            Content="&#xE892;"
                            IsEnabled="{Binding HasTrack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Previous" />

                        <Button
                            Margin="8,0"
                            Command="{Binding TogglePlaybackCommand}"
                            Content="{Binding PlayPauseGlyph}"
                            Style="{StaticResource PlayButtonStyle}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding PlayPauseTooltip}" />

                        <Button
                            Margin="0,0,6,0"
                            Content="&#xE893;"
                            IsEnabled="{Binding HasTrack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Next" />

                        <Button
                            Content="&#xE8EE;"
                            IsEnabled="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Repeat (coming soon)" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding PositionText}"
                            Style="{StaticResource CaptionTextStyle}"
                            VerticalAlignment="Center" />

                        <controls:SlimSlider
                            Grid.Column="1"
                            Margin="4,0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding DurationText}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextStyle}"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Content="&#xE767;"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Mute" />
                    <controls:SlimSlider
                        Width="110"
                        Margin="6,0,0,0"
                        Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip="Volume" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================================== -->
        <!-- Now Playing overlay                                                   -->
        <!-- ===================================================================== -->
        <!--
            Immersive view opened from the artwork in the player bar. It spans all three
            shell rows, so the sidebar, page header and player bar are replaced instead of
            being merely hidden behind it; closing it restores the shell exactly as it was,
            on whatever page the user came from. It carries its own caption strip (back
            button + window buttons) because the real one is covered.
        -->
        <Grid
            Grid.RowSpan="3"
            Background="{StaticResource WindowBackgroundBrush}"
            Visibility="{Binding IsNowPlayingOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Overlay caption: back on the left, window controls on the right -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Margin="12,0,0,0"
                    AutomationProperties.Name="Close Now Playing"
                    Command="{Binding CloseNowPlayingCommand}"
                    Content="&#xE70D;"
                    Style="{StaticResource IconButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Back to the previous page (Esc)" />

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Text="NOW PLAYING"
                    Style="{StaticResource SectionLabelStyle}"
                    VerticalAlignment="Center" />

                <!-- Same handlers as the main caption so the window stays controllable -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Content="&#xE921;"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Minimize" />
                    <Button
                        x:Name="OverlayMaximizeButton"
                        Content="&#xE922;"
                        Click="MaximizeButton_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Maximize" />
                    <Button
                        Content="&#xE8BB;"
                        Click="CloseButton_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Artwork + transport on the left, lyrics on the right -->
            <Grid Grid.Row="1" Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" MaxWidth="480" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- ===================================================== -->
                <!-- Artwork, track facts and transport                    -->
                <!-- ===================================================== -->
                <Border
                    Grid.Column="0"
                    Padding="24,24,24,20"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Artwork takes the slack so it stays vertically centred -->
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Cover art. A Viewbox keeps the placeholder square at every window
                            size; once real cover images are loaded only the child of the
                            Viewbox has to change.
                        -->
                        <Viewbox
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            StretchDirection="Both">
                            <Border
                                Width="340"
                                Height="340"
                                Background="{StaticResource HeroGradientBrush}"
                                Style="{StaticResource ArtworkFrameStyle}">
                                <Grid>
                                    <!-- Concentric rings lend the flat gradient some depth -->
                                    <Ellipse
                                        Width="248"
                                        Height="248"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="#26FFFFFF"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        Width="164"
                                        Height="164"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="#1AFFFFFF"
                                        StrokeThickness="1" />
                                    <TextBlock
                                        Text="{Binding ArtworkGlyph}"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="68"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Viewbox>

                        <!-- Track facts -->
                        <StackPanel Grid.Row="1">
                            <TextBlock
                                Text="{Binding TrackTitle}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,6,0,0"
                                Text="{Binding TrackArtist}"
                                FontSize="14"
                                Foreground="{StaticResource AccentBrush}"
                                TextTrimming="CharacterEllipsis" />

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Border Style="{StaticResource ChipStyle}">
                                    <TextBlock
                                        Text="{Binding TrackAlbumPosition}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                                <Border Margin="8,0,0,0" Style="{StaticResource ChipStyle}">
                                    <TextBlock
                                        Text="{Binding TrackAlbum}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Seek bar: same bindings as the player bar, so both stay in sync -->
                        <Grid Grid.Row="2" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{Binding PositionText}"
                                Style="{StaticResource CaptionTextStyle}"
                                VerticalAlignment="Center" />

                            <controls:SlimSlider
                                Grid.Column="1"
                                Margin="4,0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding DurationText}"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextStyle}"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Transport controls -->
                        <StackPanel
                            Grid.Row="3"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Content="&#xE8B1;"
                                IsEnabled="False"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Shuffle (coming soon)" />
                            <Button
                                Margin="8,0,0,0"
                                Content="&#xE892;"
                                IsEnabled="{Binding HasTrack}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Previous" />
                            <Button
                                Margin="10,0"
                                Command="{Binding TogglePlaybackCommand}"
                                Content="{Binding PlayPauseGlyph}"
                                Style="{StaticResource PlayButtonStyle}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding PlayPauseTooltip}" />
                            <Button
                                Margin="0,0,8,0"
                                Content="&#xE893;"
                                IsEnabled="{Binding HasTrack}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Next" />
                            <Button
                                Content="&#xE8EE;"
                                IsEnabled="False"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Repeat (coming soon)" />
                        </StackPanel>

                        <!-- Volume: the player bar is covered by the overlay, so it lives here -->
                        <StackPanel
                            Grid.Row="4"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Text="&#xE767;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <controls:SlimSlider
                                Width="120"
                                Margin="10,0,0,0"
                                Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip="Volume" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================================================== -->
                <!-- Lyrics                                                -->
                <!-- ===================================================== -->
                <Border
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="16,16,10,16"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="6,0,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="LYRICS" Style="{StaticResource SectionLabelStyle}" />

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="Click a line to jump"
                                Style="{StaticResource CaptionTextStyle}" />
                        </Grid>

                        <!--
                            The list is bound to the lyric rows; the active line carries
                            IsActive, which the item style turns into the accent highlight.
                            Clicking a row seeks through SeekToLyricCommand.
                        -->
                        <ListBox
                            x:Name="LyricList"
                            Grid.Row="1"
                            ItemsSource="{Binding Lyrics}"
                            Style="{StaticResource LyricListStyle}"
                            Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- The item template only renders text; padding and
                                         highlighting come from the container style. -->
                                    <TextBlock
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <!-- Derived from the shared style so the karaoke highlight
                                     stays in one place, plus the click-to-seek hook. -->
                                <Style BasedOn="{StaticResource LyricLineStyle}" TargetType="ListBoxItem">
                                    <EventSetter Event="MouseLeftButtonUp" Handler="LyricLine_MouseLeftButtonUp" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Shown for tracks that carry no lyric data yet -->
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasLyrics, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Center"
                                Style="{StaticResource WellStyle}">
                                <TextBlock
                                    Text="&#xE8BD;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                Text="No lyrics for this track"
                                FontSize="15"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Margin="0,6,0,0"
                                MaxWidth="320"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Text="Add an .lrc file next to the audio file and SongPlayer will follow along."
                                Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
