<Application
    x:Class="SongPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SongPlayer.Converters"
    ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design tokens must come first: every other dictionary references them. -->
                <ResourceDictionary Source="Themes/Colors.xaml" />

                <!--
                    Style dictionaries. Order matters only where one style is BasedOn another
                    (Buttons.xaml keeps its own base-to-derived order internally), but the group
                    is listed roughly from primitives to compositions for readability.
                -->
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Surfaces.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Inputs.xaml" />
                <ResourceDictionary Source="Themes/Navigation.xaml" />
                <ResourceDictionary Source="Themes/NowPlaying.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared value converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter
                x:Key="InverseBoolToVisibility"
                Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
