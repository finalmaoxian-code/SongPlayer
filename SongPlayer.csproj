<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      LibVLC ships one native build per architecture, so the executable has to commit to one.
      The runtime identifier is what pins it, and it is enough on its own: win-x64 selects the
      x64 native package and the x64 app host, so even a "Debug|Any CPU" build here produces an
      x64 process (verified: PE machine 0x8664). Declaring a second <Platforms> entry would
      instead make the solution pick one platform only and leave Visual Studio holding a
      configuration it cannot launch.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The test project lives beside the app. The SDK would otherwise compile its sources into the executable. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);SongPlayer.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SongPlayer.Tests/**" />
    <None Remove="SongPlayer.Tests/**" />
    <Content Remove="SongPlayer.Tests/**" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SongPlayer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
